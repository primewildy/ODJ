# Build artifacts
target/
**/target/

# Throwaway latency spike (not committed)
spike/

# Local music library (large, not source)
music/

# Pico firmware build output
hardware/firmware/build/

# PCB netlist-generator venv + side-artifacts (skidl regenerates these each
# run); the .py source and the .net netlist are committed.
hardware/pcb/venv/
hardware/pcb/__pycache__/
hardware/pcb/*.erc
hardware/pcb/*.log
hardware/pcb/*_sklib.py
/skidl.erc
/skidl.log
/skidl_sklib.py

# KiCad project housekeeping (backups, caches, per-user local settings).
# The project files (.kicad_pro/.kicad_pcb/.kicad_sch) can still be committed.
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
fp-info-cache
*~

# Per-build controller config (hardware-specific; .example is committed)
controls.toml

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Rust
Cargo.lock.bak
